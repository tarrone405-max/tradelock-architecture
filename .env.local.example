# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key — server-only, bypasses RLS. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# Stripe
STRIPE_SECRET_KEY=
# Signing secret for the /api/webhooks/stripe endpoint (from `stripe listen`
# in dev, or the webhook's settings page in the Stripe Dashboard in prod).
STRIPE_WEBHOOK_SECRET=
# Recurring Price ID for the $49/month TradeLock Pro plan.
STRIPE_PRICE_ID=
# Cut TradeLock takes of each direct change-order payment, in basis points
# (e.g. 250 = 2.5%). Leave unset/0 for providers to keep 100%.
STRIPE_APPLICATION_FEE_BPS=

# Resend
RESEND_API_KEY=
# Verified sender — defaults to Resend's shared test address, which only
# delivers to your own Resend account email until a domain is verified.
RESEND_FROM_EMAIL=TradeLock <onboarding@resend.dev>

# App
NEXT_PUBLIC_SITE_URL=http://localhost:3000
