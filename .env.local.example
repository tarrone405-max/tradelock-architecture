# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key — server-only, bypasses RLS. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# Stripe
STRIPE_SECRET_KEY=
# Signing secret for the /api/webhooks/stripe endpoint (from `stripe listen`
# in dev, or the webhook's settings page in the Stripe Dashboard in prod).
STRIPE_WEBHOOK_SECRET=
# Signing secret for the /api/webhooks/stripe/connect endpoint — a SEPARATE
# webhook endpoint/secret in the Stripe Dashboard, subscribed to
# connected-account events (account.updated, account.application.deauthorized).
# Different from STRIPE_WEBHOOK_SECRET above; do not reuse the same value.
STRIPE_CONNECT_WEBHOOK_SECRET=
# Recurring Price IDs for the paid plans — see lib/plans.ts for prices/fee
# rates. Free has no Stripe Price at all (no subscription is ever created
# for it). The old single-plan STRIPE_PRICE_ID and the global
# STRIPE_APPLICATION_FEE_BPS are retired — the Connect application fee is
# now looked up per-provider from their subscription_tier instead of one
# platform-wide rate.
STRIPE_PRICE_ID_PRO=
STRIPE_PRICE_ID_BUSINESS=

# Resend
RESEND_API_KEY=
# Verified sender — defaults to Resend's shared test address, which only
# delivers to your own Resend account email until a domain is verified.
RESEND_FROM_EMAIL=TradeLock <onboarding@resend.dev>
# Where provider/client bug reports and suggestions (the in-app feedback
# form) get emailed. Leave unset to just log them instead of sending.
FEEDBACK_NOTIFICATION_EMAIL=

# App
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Any random string — must match what's set on the Vercel project too.
# Vercel Cron sends this automatically as a Bearer token when it hits
# /api/cron/payment-reminders; without it that route always 500s.
CRON_SECRET=
